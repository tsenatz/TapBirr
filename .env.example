# TapBirr environment
# Copy to .env and fill in. .env is git-ignored.
#
# Telebirr / Ethio Telecom SuperApp gateway credentials.
# Request them from the Ethio Telecom fabric portal (developer.ethiotelecom.et
# -> dashboard). See docs/telebirr.md for the full field reference.

# "sandbox" (testbed) or "production".
TELEBIRR_ENV=sandbox

# Fabric application identity. Both are issued by the fabric portal.
TELEBIRR_X_APP_KEY=
TELEBIRR_APP_SECRET=

# Merchant identity, registered against the fabric application above.
TELEBIRR_APP_ID=
TELEBIRR_MERCH_CODE=

# RSA key pair. Register TELEBIRR_PUBLIC_KEY with the SP, then keep the private
# key here. Newlines may be written as \n. A base64 body may be supplied in the
# *_BASE64 variants instead.
TELEBIRR_PRIVATE_KEY=
TELEBIRR_PUBLIC_KEY=
# TELEBIRR_PRIVATE_KEY_BASE64=
# TELEBIRR_PUBLIC_KEY_BASE64=

# Endpoints. Defaults are derived from TELEBIRR_ENV; override only if needed.
# TELEBIRR_BASE_URL=https://developerportal.ethiotelebirr.et:38443/apiaccess/payment/gateway
# TELEBIRR_WEB_BASE_URL=https://developerportal.ethiotelebirr.et:38443/payment/web/h5/paygate?

# Must be publicly reachable and whitelisted on the SP, or callbacks never arrive.
TELEBIRR_NOTIFY_URL=
TELEBIRR_REDIRECT_URL=

# Order defaults.
TELEBIRR_TRADE_TYPE=WebCheckout
TELEBIRR_CURRENCY=ETB
TELEBIRR_TIMEOUT_EXPRESS=120m
TELEBIRR_BUSINESS_TYPE=TransferToOtherOrg

# Signature padding: "pss" (default, per the portal's Interface Signing rules) or "pkcs1".
# Some language demos use pkcs1; flip this if the gateway reports "verify sign failed".
TELEBIRR_SIGN_PADDING=pss

# The sandbox certificate chains to a GlobalSign intermediate that is absent
# from most trust stores. Keep true for the testbed; set false in production.
TELEBIRR_TLS_INSECURE=true
TELEBIRR_TIMEOUT_MS=30000

# TapBirr API
# PORT=5000
# HOST=0.0.0.0
# NODE_ENV=development

# Dev bearer token for routes protected by docs/API.md. Switch off locally with
# API_REQUIRE_AUTH=false; never ship the default to production.
API_REQUIRE_AUTH=true
API_DEV_TOKEN=tapbirr-dev-token
# API_STORE_FILE=/tmp/.tapbirr-store.json
